#!/usr/bin/env python3
import os, sys
if sys.version_info < (3, 10):  # stock macOS python3 is 3.9: say so, instead of failing somewhere later
    sys.exit("gh-upstream-watch needs Python 3.10 or newer; %s is %s. Install a newer python3 (macOS: "
             "brew install python), or install the tool with uv, which brings its own Python: uv tool install "
             "gh-upstream-watch. To stay on 3.9, pin the extension to the last release for it: "
             "gh extension remove upstream-watch && "
             "gh extension install colinmcnamara/gh-upstream-watch --pin v0.3.3" % (sys.executable, sys.version.split()[0]))
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "src"))
from gh_upstream_watch.cli import main
sys.exit(main())
